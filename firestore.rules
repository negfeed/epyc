rules_version = '2';

// EPYC game data. Any signed-in user may read/write game documents — this
// matches the original app's trust model (authenticated players collaborate on
// shared games/drawings). Tighten to per-document ownership/membership before a
// production launch.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
